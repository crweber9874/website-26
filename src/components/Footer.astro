---
import { site } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink px-6 py-16 md:px-10">
  <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl font-semibold">{site.name}</p>
      <p class="mt-2 text-sm text-paper/60">{site.role}</p>
    </div>
    <div class="text-sm text-paper/70">
      <p class="mb-2 font-mono text-xs uppercase tracking-widest text-terra">
        Let's talk
      </p>
      <p>{site.affiliation}</p>
      <p>{site.office}</p>
      <a class="link-underline mt-2 inline-block" href={`mailto:${site.email}`}>
        {site.email}
      </a>
    </div>
    <div class="text-sm text-paper/70">
      <p class="mb-2 font-mono text-xs uppercase tracking-widest text-terra">
        Elsewhere
      </p>
      <ul class="space-y-1">
        <li>
          <a class="link-underline" href={site.voterProject} target="_blank"
            >The Arizona Voter Project</a
          >
        </li>
        <li>
          <a class="link-underline" href={site.github} target="_blank">GitHub</a>
        </li>
      </ul>
    </div>
  </div>
  <div
    class="mx-auto mt-12 flex max-w-7xl flex-col items-center justify-between gap-2 border-t border-white/10 pt-6 text-xs text-paper/40 md:flex-row"
  >
    <p>© {year} {site.name}. All rights reserved.</p>
    <p class="font-mono">{site.domain}</p>
  </div>
</footer>
