---
import { nav, site } from "@/data/site";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  id="site-nav"
  class="fixed top-0 left-0 z-50 w-full transition-all duration-500"
  data-nav
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 md:px-10"
  >
    <a
      href="/"
      class="font-display text-lg font-semibold tracking-tight text-paper"
    >
      Christopher <span class="text-paper/50">Weber</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "link-underline text-sm font-medium tracking-wide transition-colors",
              isActive(item.href) ? "text-paper" : "text-paper/50 hover:text-paper",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      id="menu-toggle"
      class="flex flex-col gap-1.5 md:hidden"
      aria-label="Toggle menu"
    >
      <span class="block h-px w-6 bg-paper transition-all"></span>
      <span class="block h-px w-6 bg-paper transition-all"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-white/10 bg-ink/95 px-6 py-4 backdrop-blur-md md:hidden"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "py-2 text-base font-medium",
            isActive(item.href) ? "text-paper" : "text-paper/60",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 40) {
      nav.classList.add("bg-ink/80", "backdrop-blur-md", "shadow-lg", "shadow-black/20");
      nav.classList.remove("py-5");
    } else {
      nav.classList.remove("bg-ink/80", "backdrop-blur-md", "shadow-lg", "shadow-black/20");
    }
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
    menu?.classList.toggle("flex");
  });
</script>
