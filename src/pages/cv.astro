---
import Layout from "../layouts/Layout.astro";
import aboutRaw from "../data/about.yml?raw";
import siteConfig from "../side.config";
import { parse } from "yaml";
import { getAllPapers } from "../lib/papers";

const about = parse(aboutRaw) ?? {};
const experience = about.experience ?? [];
const education = about.education ?? [];
const service = about.service ?? [];
const sections = about.sections ?? [];

const papers = getAllPapers();
const published = papers.filter((paper) => paper.category === "Publication");
const inProgress = papers.filter(
  (paper) => paper.category === "Work in Progress" || paper.category === "Working Paper",
);

const pageTitle = "Curriculum Vitae";
const pageDescription =
  "Appointments, education, service, honors, and the full publication record.";

const formatAuthors = (authors: string[]) => authors.join(", ");
---

<Layout title={pageTitle} description={pageDescription} schemaType="CollectionPage">
  <div class="page-stack">
    <header class="page-header">
      <p class="page-kicker">{siteConfig.author}</p>
      <h1 class="page-title">{pageTitle}</h1>
      <p class="page-description">{pageDescription}</p>
      <div class="flex flex-wrap gap-2 pt-2">
        <button
          type="button"
          id="cv-print"
          class="action-link glass-control px-3.5 min-h-11"
        >
          <span class="i-mdi:printer" aria-hidden="true"></span>
          Print / save as PDF
        </button>
        <a href="/researches" class="action-link glass-control px-3.5 min-h-11">
          <span class="i-mdi:file-document-outline" aria-hidden="true"></span>
          Publications with abstracts
        </a>
      </div>
    </header>

    <section class="content-section space-y-4">
      <h2 class="section-heading border-b border-gray-200 pb-3 dark:border-gray-700">
        Appointments
      </h2>
      <ul class="space-y-3">
        {
          experience.map((entry: any) => (
            <li class="cv-row">
              <span class="cv-period">{entry.period}</span>
              <span>
                <span class="font-semibold">{entry.role}</span>
                <span class="text-gray-600 dark:text-gray-300"> — {entry.organization}</span>
                {entry.bullets && (
                  <ul class="mt-1 space-y-1">
                    {entry.bullets.map((bullet: string) => (
                      <li class="body-copy">{bullet}</li>
                    ))}
                  </ul>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="content-section space-y-4">
      <h2 class="section-heading border-b border-gray-200 pb-3 dark:border-gray-700">
        Education
      </h2>
      <ul class="space-y-3">
        {
          education.map((entry: any) => (
            <li class="cv-row">
              <span class="cv-period">{entry.year}</span>
              <span>
                <span class="font-semibold">{entry.degree}</span>
                <span class="text-gray-600 dark:text-gray-300"> — {entry.institution}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="content-section space-y-4">
      <h2 class="section-heading border-b border-gray-200 pb-3 dark:border-gray-700">
        Publications
      </h2>
      <ol class="space-y-3">
        {
          published.map((paper) => (
            <li class="cv-row">
              <span class="cv-period">{paper.year}</span>
              <span class="body-copy">
                {formatAuthors(paper.authors)}. <em>{paper.title}.</em>
                {paper.venue && <span class="text-gray-600 dark:text-gray-300"> {paper.venue}.</span>}
                {paper.url && (
                  <a href={paper.url} class="ml-1 font-mono text-xs underline" rel="noreferrer">
                    link
                  </a>
                )}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    {
      inProgress.length > 0 && (
        <section class="content-section space-y-4">
          <h2 class="section-heading border-b border-gray-200 pb-3 dark:border-gray-700">
            Manuscripts in progress
          </h2>
          <ul class="space-y-3">
            {inProgress.map((paper) => (
              <li class="cv-row">
                <span class="cv-period">{paper.year}</span>
                <span class="body-copy">
                  {formatAuthors(paper.authors)}. <em>{paper.title}.</em>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="content-section space-y-4">
      <h2 class="section-heading border-b border-gray-200 pb-3 dark:border-gray-700">
        Service
      </h2>
      <ul class="space-y-3">
        {
          service.map((entry: any) => (
            <li class="cv-row">
              <span class="cv-period">{entry.period}</span>
              <span>
                <span class="font-semibold">{entry.role}</span>
                <span class="text-gray-600 dark:text-gray-300"> — {entry.organization}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      sections.map((section: any) => (
        <section class="content-section space-y-4">
          <h2 class="section-heading border-b border-gray-200 pb-3 dark:border-gray-700">
            {section.title}
          </h2>
          <ul class="space-y-3">
            {(section.items ?? []).map((item: any) =>
              typeof item === "string" ? (
                <li class="body-copy">{item}</li>
              ) : (
                <li class="cv-row">
                  <span class="cv-period">{item.date}</span>
                  <span>
                    <span class="font-semibold">{item.title}</span>
                    {item.subtitle && (
                      <span class="text-gray-600 dark:text-gray-300"> — {item.subtitle}</span>
                    )}
                    {item.description && (
                      <p class="body-copy mt-1">
                        {/^https?:\/\//.test(item.description) ? (
                          <a href={item.description} class="underline" rel="noreferrer">
                            {item.description}
                          </a>
                        ) : (
                          item.description
                        )}
                      </p>
                    )}
                  </span>
                </li>
              ),
            )}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    document
      .getElementById("cv-print")
      ?.addEventListener("click", () => window.print());
  });
</script>

<style is:global>
  .cv-row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .cv-period {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: rgb(107 114 128);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .cv-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  @media print {
    header nav,
    footer,
    .page-kicker,
    #cv-print,
    .action-link {
      display: none !important;
    }
  }
</style>
