---
import { getCollection } from "astro:content"

import CommonLayout from "@/layouts/CommonLayout.astro"
import Section from "@/components/layout/Section.astro"
import ExperienceTimeline from "@/components/timeline/ExperienceTimeline.astro"
import { honors, media, service, skills, workingPapers } from "@/data/cv"
import { loadAllPublications } from "@/lib/publications/loader"

const experience = await getCollection("experience")
const appointments = experience.filter((e) => e.data.category === "research")
const education = experience.filter((e) => e.data.category === "education")
const { allPublicationsFlat: publications } = await loadAllPublications()

const description =
  "Appointments, education, honors, service, and the full publication record."
---

<CommonLayout
  title="Curriculum Vitae"
  description={description}
  breadcrumbs={[{ label: "CV" }]}
  prose={false}
>
  <Section title="Appointments">
    <ExperienceTimeline entries={appointments} />
  </Section>

  <Section title="Education">
    <ExperienceTimeline entries={education} />
  </Section>

  <Section title="Honors, awards, and grants">
    <ul class="cv-list">
      {honors.map((honor) => <li>{honor}</li>)}
    </ul>
  </Section>

  <Section title="Service">
    <ul class="cv-list">
      {service.map((entry) => (
        <li>
          <span class="cv-years">{entry.years}</span> {entry.role}
        </li>
      ))}
    </ul>
  </Section>

  <Section title="Works in progress">
    <ul class="cv-list">
      {workingPapers.map((paper) => <li>{paper}</li>)}
    </ul>
  </Section>

  <Section title="Publications" moreLink="/publications" moreText="with abstracts →">
    <ol class="cv-publications">
      {publications.map((pub) => (
        <li>
          <span class="cv-pub-year">{pub.year}</span>
          <span>
            {pub.authorData.displayFirstAuthors}
            {pub.authorData.hasMore && ", et al."}. <em>{pub.title}</em>
            {pub.publisher && <span class="cv-venue">. {pub.publisher}</span>}
          </span>
        </li>
      ))}
    </ol>
  </Section>

  <Section title="Technology and skills">
    <ul class="cv-list">
      {skills.map((skill) => (
        <li>
          <strong>{skill.label}</strong> — {skill.detail}
        </li>
      ))}
    </ul>
  </Section>

  <Section title="Recent media">
    <ul class="cv-list">
      {media.map((item) => (
        <li>
          <strong>{item.outlet}</strong> —{" "}
          {item.href ? (
            <a href={item.href} rel="noopener noreferrer" target="_blank">
              {item.note}
            </a>
          ) : (
            item.note
          )}
        </li>
      ))}
    </ul>
  </Section>
</CommonLayout>

<style>
  .cv-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
    max-inline-size: 72ch;
  }

  .cv-list li {
    padding-inline-start: var(--space-2xs);
    border-inline-start: 2px solid var(--border);
  }

  .cv-years {
    display: inline-block;
    min-inline-size: 6.5rem;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  .cv-publications {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
    max-inline-size: 72ch;
  }

  .cv-publications li {
    display: flex;
    gap: var(--space-2xs);
    align-items: baseline;
  }

  .cv-pub-year {
    flex-shrink: 0;
    min-inline-size: 3rem;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  .cv-venue {
    color: var(--muted-foreground);
  }
</style>
