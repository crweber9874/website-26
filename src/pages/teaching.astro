---
import Layout from "../layouts/Layout.astro";
import FilterBar from "../components/FilterBar.astro";
import teachingRaw from "../data/teaching.yml?raw";
import siteConfig from "../side.config";
import { parse } from "yaml";
import { normalizeTeachingSection, teachingDataSchema } from "../lib/teaching";

const teachingData = teachingDataSchema.parse(parse(teachingRaw) ?? {});
const current = (teachingData.current || []).map(normalizeTeachingSection);
const past = (teachingData.past || []).map(normalizeTeachingSection);

const pageTitle = siteConfig.pageTitles.teaching.title || "Teaching";
const pageDescription = siteConfig.pageTitles.teaching.description ||
  "Courses designed to bridge technical skills with critical inquiry.";

// Count total courses
const totalCurrent = current.reduce((acc, s) => acc + (s.modules?.length || 0), 0);
const totalPast = past.reduce((acc, s) => acc + (s.modules?.length || 0), 0);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schemaType="CollectionPage"
>
  <div class="page-stack">
    <header class="page-header">
      <p class="page-kicker">Teaching portfolio</p>
      <h1 class="page-title">{pageTitle}</h1>
      <p class="page-description">{pageDescription}</p>

      <div class="how-to-read">
        <p>
          <strong>How to use these.</strong> Each course has a reader — a book I
          wrote for the course — that you read <em>alongside</em> the textbooks
          listed with it, not instead of them. The readers restate the standard
          material in one notation, work every example in R, and show the code.
        </p>
        <p>
          Take the two in order: <strong>POL 682</strong> builds the linear model
          and the assumptions behind it; <strong>POL 683</strong> picks up where
          those assumptions run out.
        </p>
        <p class="how-to-read-source">
          The readers are written in the
          <a
            href="https://github.com/crweber9874/methodology_ground_up"
            target="_blank"
            rel="noreferrer">methodology_ground_up</a
          >
          repository, a shared teaching hub with Chad Westerland, and published here.
        </p>
      </div>

      {
        totalPast > 0 && (
          <div class="pt-2">
            <FilterBar
              total={totalCurrent + totalPast}
              allIcon="i-mdi:school"
              items={[
                { filter: "current", label: "current", count: totalCurrent, icon: "i-mdi:calendar-check" },
                { filter: "past", label: "past", count: totalPast, icon: "i-mdi:history" },
              ]}
            />
          </div>
        )
      }
    </header>

    <div class="space-y-6 sm:space-y-7" id="teaching-container">
      <!-- Current Modules -->
      {
        current.length > 0 && (
          <section
            id="current"
            class="content-section teaching-section scroll-mt-20 space-y-5"
            data-filter-section="current"
          >
            <header class="flex items-end justify-between gap-4 border-b border-gray-200 pb-3 dark:border-gray-700">
              <div class="space-y-1">
                <p class="section-kicker">Now teaching</p>
                <h2 class="section-heading">Current Courses</h2>
              </div>
              <p class="shrink-0 text-xs font-semibold uppercase tracking-[0.14em] text-accent-700 dark:text-accent-300">
                {totalCurrent} {totalCurrent === 1 ? "course" : "courses"}
              </p>
            </header>

            <div class="space-y-6">
              {current.map((section) => (
                <div class="space-y-4">
                  <div class="flex items-center gap-3">
                    <h3 class="section-kicker shrink-0 text-accent-700 dark:text-accent-300">{section.term}</h3>
                    <div class="h-px flex-1 bg-gray-200 dark:bg-gray-700" aria-hidden="true"></div>
                  </div>

                  <div class="grid gap-4 md:grid-cols-2">
                    {(section.modules || []).map((module) => (
                      <article class="surface-card-hover border-t-2 border-t-accent-500">
                        <div class="space-y-3">
                          <div class="flex flex-wrap items-start justify-between gap-3">
                            <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-accent-700 dark:text-accent-300">
                              {module.code}
                            </p>
                            {module.links.length > 0 && (
                              <div class="flex flex-wrap justify-end gap-1">
                                {module.links.map((link) => (
                                  <a href={link.href} class="action-link min-h-11">
                                    <span class={link.icon ?? "i-mdi:book-open-variant"} aria-hidden="true"></span>
                                    {link.label}
                                  </a>
                                ))}
                              </div>
                            )}
                          </div>

						  <h4 class="entry-title">
                            {module.title}
                          </h4>

						  <p class="entry-summary">
                            {module.summary}
                          </p>

                          {module.badges.length > 0 && (
                            <div class="flex flex-wrap gap-2">
                              {module.badges.map((badge) => (
                                <span class="meta-chip">{badge}</span>
                              ))}
                            </div>
                          )}

                          {module.highlights.length > 0 && (
                            <div class="course-block">
                              <p class="course-block-label">What the reader covers</p>
                              <ul class="space-y-2 border-l-2 border-accent-200 pl-4 dark:border-accent-800">
                                {module.highlights.map((highlight) => (
                                  <li class="body-copy">{highlight}</li>
                                ))}
                              </ul>
                            </div>
                          )}

                          {module.texts.length > 0 && (
                            <div class="course-block">
                              <p class="course-block-label">
                                Companion texts — read alongside the reader
                              </p>
                              <ul class="space-y-2 border-l-2 border-gray-200 pl-4 dark:border-gray-700">
                                {module.texts.map((text) => (
                                  <li class="body-copy">
                                    <span class="font-medium">{text.authors}</span>
                                    {text.year && <span> ({text.year}).</span>}{" "}
                                    <em>{text.title}.</em>
                                    {text.publisher && <span> {text.publisher}.</span>}
                                  </li>
                                ))}
                              </ul>
                            </div>
                          )}

                          {module.tags.length > 0 && (
                            <div class="flex flex-wrap gap-x-3 gap-y-1 border-t border-gray-200 pt-3 dark:border-gray-700">
                              {module.tags.map((tag) => (
                                <span class="text-xs font-medium text-gray-600 dark:text-gray-300">
                                  #{tag}
                                </span>
                              ))}
                            </div>
                          )}
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- Past Modules -->
      {
        past.length > 0 && (
          <section
            id="past"
            class="content-section teaching-section scroll-mt-20 space-y-5"
            data-filter-section="past"
          >
            <header class="flex items-end justify-between gap-4 border-b border-gray-200 pb-3 dark:border-gray-700">
              <div class="space-y-1">
                <p class="section-kicker">Teaching archive</p>
                <h2 class="section-heading">Past Courses</h2>
              </div>
              <p class="shrink-0 text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400">
                {totalPast} {totalPast === 1 ? "course" : "courses"}
              </p>
            </header>

            <div class="space-y-6">
              {past.map((section) => (
                <div class="space-y-4">
                  <div class="flex items-center gap-3">
                    <h3 class="section-kicker shrink-0">{section.term}</h3>
                    <div class="h-px flex-1 bg-gray-200 dark:bg-gray-700" aria-hidden="true"></div>
                  </div>

                  <div class="grid gap-4 md:grid-cols-2">
                    {(section.modules || []).map((module) => (
                      <article class="surface-card-hover">
                        <div class="space-y-3">
                          <div class="flex flex-wrap items-start justify-between gap-3">
                            <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-gray-600 dark:text-gray-300">
                              {module.code}
                            </p>
                            {module.links.length > 0 && (
                              <div class="flex flex-wrap justify-end gap-1">
                                {module.links.map((link) => (
                                  <a
                                    href={link.href}
                                    target="_blank"
                                    rel="noreferrer"
                                    class="action-link min-h-11"
                                  >
                                    <span class={link.icon ?? "i-mdi:archive"} aria-hidden="true"></span>
                                    {link.label}
                                  </a>
                                ))}
                              </div>
                            )}
                          </div>

						  <h4 class="entry-title">
                            {module.title}
                          </h4>

						  <p class="entry-summary">
                            {module.summary}
                          </p>

                          {module.badges.length > 0 && (
                            <div class="flex flex-wrap gap-2">
                              {module.badges.map((badge) => (
                                <span class="meta-chip">{badge}</span>
                              ))}
                            </div>
                          )}

                          {module.highlights.length > 0 && (
                            <ul class="space-y-2 border-l-2 border-gray-200 pl-4 dark:border-gray-700">
                              {module.highlights.slice(0, 3).map((highlight) => (
                                <li class="body-copy">{highlight}</li>
                              ))}
                            </ul>
                          )}

                          {module.tags.length > 0 && (
                            <div class="flex flex-wrap gap-x-3 gap-y-1 border-t border-gray-200 pt-3 dark:border-gray-700">
                              {module.tags.map((tag) => (
                                <span class="text-xs font-medium text-gray-600 dark:text-gray-300">
                                  #{tag}
                                </span>
                              ))}
                            </div>
                          )}
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</Layout>

<script>
  import { setupFilterControls } from "../scripts/ui";

  document.addEventListener("astro:page-load", () => {
    setupFilterControls();
  });
</script>

<style>
  .how-to-read {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding-left: 1rem;
    border-left: 3px solid rgb(var(--un-preset-theme-colors-accent-500, 12 35 75));
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .how-to-read p {
    margin: 0;
  }

  .how-to-read-source {
    font-size: 0.875rem;
    opacity: 0.75;
  }

  .how-to-read a {
    text-decoration: underline;
  }

  .course-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .course-block-label {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.7;
  }
</style>
