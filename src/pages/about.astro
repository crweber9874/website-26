---
import Base from "@/layouts/Base.astro";
import { site } from "@/data/site";
import {
  education,
  employment,
  honors,
  service,
  skills,
  media,
  workingPapers,
} from "@/data/cv";
---

<Base title="About">
  <!-- Intro -->
  <section class="bg-ink px-6 pb-20 pt-40 md:px-10">
    <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-[1fr_240px] md:items-start">
      <div>
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-terra" data-reveal>
        About
      </p>
      <h1
        class="mt-4 font-display text-4xl font-light leading-tight tracking-tight text-paper sm:text-5xl"
        data-reveal
      >
        Christopher Weber
      </h1>
      <p class="mt-3 text-sm text-paper/50" data-reveal>
        Professor of Political Science · University of Arizona · Ph.D., Stony
        Brook · Director, The Arizona Voter Project
      </p>
      <div class="mt-8 space-y-5 text-lg leading-relaxed text-paper/75" data-reveal>
        <p>
          I am a Professor in the School of Government and Public Policy at the
          University of Arizona, where I direct <a
            href={site.voterProject}
            target="_blank"
            rel="noopener"
            class="link-underline text-terra">The Arizona Voter Project</a
          >. I received my Ph.D. in political science from Stony Brook University
          in 2008.
        </p>
        <p>
          My research sits at the intersection of political psychology and
          political behavior, with a focus on American political campaigns,
          ideology, and authoritarianism. I also work extensively in political
          methodology — experimental design, measurement, and, increasingly, the
          data science of large voter files. My work has appeared in the
          <em>American Journal of Political Science</em>, the
          <em>Journal of Politics</em>, <em>Political Behavior</em>,
          <em>Political Psychology</em>, and elsewhere.
        </p>
      </div>
      </div>

      <!-- Portrait: drop a headshot at /public/images/weber.jpg -->
      <div
        class="relative mx-auto aspect-[4/5] w-48 shrink-0 overflow-hidden rounded-xl border border-white/10 md:w-full"
        data-reveal
      >
        <div
          class="absolute inset-0 bg-gradient-to-br from-ink-700 to-ink"
          aria-hidden="true"
        >
        </div>
        <img
          src="/images/weber.jpg"
          alt="Christopher Weber"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
          onerror="this.style.display='none'"
        />
      </div>
    </div>
  </section>

  <!-- Education + Employment -->
  <section class="bg-paper px-6 py-20 text-ink md:px-10">
    <div class="mx-auto grid max-w-5xl gap-16 md:grid-cols-2">
      <div data-reveal>
        <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-terra">
          Education
        </h2>
        <div class="mt-6 space-y-6">
          {
            education.map((e) => (
              <div>
                <p class="font-display text-xl">{e.school}</p>
                {e.items.map((it) => (
                  <p class="mt-1 text-sm text-ink/60">{it}</p>
                ))}
              </div>
            ))
          }
        </div>
      </div>
      <div data-reveal>
        <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-terra">
          Appointments
        </h2>
        <div class="mt-6 space-y-5">
          {
            employment.map((e) => (
              <div class="flex gap-4">
                <span class="w-24 shrink-0 font-mono text-sm text-ink/50">
                  {e.years}
                </span>
                <div>
                  <p class="font-medium">{e.role}</p>
                  <p class="text-sm text-ink/60">{e.org}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Honors + Service -->
  <section class="bg-ink px-6 py-20 md:px-10">
    <div class="mx-auto grid max-w-5xl gap-16 md:grid-cols-2">
      <div data-reveal>
        <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-terra">
          Honors, Awards & Grants
        </h2>
        <ul class="mt-6 space-y-4">
          {
            honors.map((h) => (
              <li class="border-l-2 border-terra/40 pl-4 text-sm leading-relaxed text-paper/75">
                {h}
              </li>
            ))
          }
        </ul>
      </div>
      <div data-reveal>
        <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-terra">
          Selected Service
        </h2>
        <div class="mt-6 space-y-4">
          {
            service.map((s) => (
              <div class="flex gap-4">
                <span class="w-24 shrink-0 font-mono text-sm text-paper/50">
                  {s.years}
                </span>
                <p class="text-sm text-paper/80">{s.role}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="bg-paper px-6 py-20 text-ink md:px-10">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-terra" data-reveal>
        Technology & Skills
      </h2>
      <div class="mt-8 grid gap-px overflow-hidden rounded-2xl bg-ink/10 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
        {
          skills.map((s) => (
            <div class="bg-paper p-6">
              <p class="font-display text-lg">{s.label}</p>
              <p class="mt-1 text-sm text-ink/60">{s.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Working papers -->
  <section class="bg-ink px-6 py-20 md:px-10">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-terra" data-reveal>
        Works in Progress
      </h2>
      <ul class="mt-6 space-y-4" data-reveal>
        {
          workingPapers.map((w) => (
            <li class="flex gap-4 text-paper/80">
              <span class="text-terra">—</span>
              <span class="text-base leading-relaxed">{w}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Media -->
  <section class="bg-paper px-6 py-20 text-ink md:px-10">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-terra" data-reveal>
        Recent Media
      </h2>
      <div class="mt-8 divide-y divide-ink/10" data-reveal>
        {
          media.map((m) => (
            <div class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6">
              <span class="w-64 shrink-0 font-display text-lg">{m.outlet}</span>
              {m.href ? (
                <a
                  href={m.href}
                  target="_blank"
                  rel="noopener"
                  class="link-underline text-sm text-ink/70"
                >
                  {m.note}
                </a>
              ) : (
                <span class="text-sm text-ink/70">{m.note}</span>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
