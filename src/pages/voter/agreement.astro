---
import AvpLayout from "@/layouts/AvpLayout.astro";
import Agreement from "@/modules/avp/agreement/components/Agreement.jsx";
import { loadAgreement } from "@/modules/avp/agreement/lib/agreement.js";
import { loadContent, fillTemplate } from "@/modules/avp/shared/lib/content.js";

const data = loadAgreement();
const { sections } = loadContent("agree");
const ui = sections.ui;
const copy = {
  rankHead: ui.rankHead,
  avgCaption: ui.avgCaptionTemplate,
  lede: ui.ledeTemplate,
  overlapBroad: ui.overlapBroad,
  overlapPartial: ui.overlapPartial,
  overlapLow: ui.overlapLow,
  sharedLegend: ui.sharedLegend,
  read: ui.readTemplate,
  readHigh: ui.readHighTemplate,
  n: ui.nTemplate,
  footer: fillTemplate(ui.footer, {
    minCell: data.meta?.min_cell ?? 25,
    fileDate: data.meta?.file_date ?? "",
  }),
};
---

<AvpLayout title="Common Ground" module="agreement">
  <section class="story-hero">
    <div class="wrap">
      <div class="eyebrow">{sections.hero.eyebrow}</div>
      <h1>{sections.hero.title}</h1>
      <p class="lede" set:html={sections.hero.body} />
    </div>
  </section>
  <main class="wrap content-after-hero">
    <Agreement
      client:only="react"
      rows={data.rows}
      densityByKey={data.densityByKey}
      meta={data.meta}
      copy={copy}
    />
  </main>
</AvpLayout>
