---
import AvpLayout from "@/layouts/AvpLayout.astro";
import Opinion from "@/modules/avp/opinion/components/Opinion.jsx";
import { loadOpinion } from "@/modules/avp/opinion/lib/opinion.js";
import { loadContent, fillTemplate } from "@/modules/avp/shared/lib/content.js";

const data = loadOpinion();
const { sections } = loadContent("opinion");
const hero = sections.hero;
const copy = {
  ...sections,
  about: {
    ...sections.about,
    body: fillTemplate(sections.about.body, { minCell: data.meta?.min_cell ?? 25 }),
    followup: sections.about.followup,
    footer: fillTemplate(sections.about.footerTemplate, {
      fileDate: data.meta?.file_date ?? "",
    }),
  },
};
---

<AvpLayout title="Public Opinion" module="opinion">
  <section class="story-hero">
    <div class="wrap">
      <div class="eyebrow">{hero.eyebrow}</div>
      <h1>{hero.title}</h1>
      <p class="lede" set:html={hero.body} />
    </div>
  </section>
  <main class="wrap content-after-hero">
    <Opinion
      client:only="react"
      opinion={data.opinion}
      radar={data.radar}
      leastLiked={data.leastLiked}
      gap={data.gap}
      meta={data.meta}
      copy={copy}
    />
  </main>
</AvpLayout>
