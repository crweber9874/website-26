---
import AvpLayout from "@/layouts/AvpLayout.astro";
import PrecinctExplorer from "@/modules/avp/voting/components/PrecinctExplorer.jsx";
import { loadContent } from "@/modules/avp/shared/lib/content.js";

const { sections } = loadContent("voting");
const hero = sections.hero;
---

<AvpLayout title="Voting" module="voting">
  <section class="hero hero-compact">
    <div class="wrap">
      <div class="eyebrow">{hero.eyebrow}</div>
      <h1 class={hero.titleClass}>{hero.title}</h1>
      <p class="lede" set:html={hero.body} />
    </div>
  </section>
  <main class="wrap content-after-hero">
    <section class="card" style="margin-bottom:16px">
      <p style="margin:0 0 8px" set:html={sections.intro.body} />
      <p class="note" style="margin:0" set:html={sections.mapNote.body} />
    </section>
    <PrecinctExplorer client:only="react" />
  </main>
</AvpLayout>
