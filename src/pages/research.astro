---
import Base from "@/layouts/Base.astro";
import {
  selectedThemes as themes,
  doiUrl,
  featuredBook,
} from "@/data/publications";

// Amazon cover thumbnail by ISBN-10; falls back to a typographic cover on error.
const bookCover = "https://images-na.ssl-images-amazon.com/images/P/0197813348.01.LZZZZZZZ.jpg";

const typeLabel: Record<string, string> = {
  book: "Book",
  article: "Article",
  chapter: "Chapter",
  reference: "Reference",
};
---

<Base title="Research">
  <!-- Header -->
  <section class="relative bg-ink px-6 pb-16 pt-40 md:px-10">
    <div class="mx-auto max-w-5xl">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-terra" data-reveal>
        Research
      </p>
      <h1
        class="mt-4 font-display text-4xl font-light leading-tight tracking-tight text-paper sm:text-6xl"
        data-reveal
      >
        Selected publications
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-paper/70" data-reveal>
        A selection of recent work in leading journals, organized by theme.
        Expand any item to read the abstract, or see the
        <a href="/cv" class="link-underline text-terra">full curriculum vitae</a>
        for the complete list.
      </p>

      <!-- Theme jump nav -->
      <nav class="mt-10 flex flex-wrap gap-2" data-reveal>
        {
          themes.map((t) => (
            <a
              href={`#${t.id}`}
              class="rounded-full border border-white/15 px-4 py-1.5 text-xs font-medium text-paper/70 transition-colors hover:border-terra hover:text-terra"
            >
              {t.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- Featured book -->
  <section class="bg-ink px-6 pb-8 md:px-10">
    <div class="mx-auto max-w-5xl">
      <div
        class="grid gap-8 rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:grid-cols-[168px_1fr] sm:p-8"
        data-reveal
      >
        <a
          href={featuredBook.amazon}
          target="_blank"
          rel="noopener"
          class="group relative block aspect-[2/3] overflow-hidden rounded-lg border border-white/10 shadow-2xl shadow-black/40"
        >
          <div
            class="absolute inset-0 flex flex-col justify-between bg-gradient-to-br from-ink-700 to-ink p-4"
          >
            <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-paper/40">
              Oxford University Press
            </span>
            <span class="font-display text-lg font-medium leading-tight text-paper">
              The Authoritarian Divide
            </span>
            <span class="font-mono text-[10px] text-paper/40">Federico · Feldman · Weber</span>
          </div>
          <img
            src={bookCover}
            alt="The Authoritarian Divide — book cover"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            onerror="this.style.display='none'"
          />
        </a>

        <div>
          <span
            class="inline-block rounded-full bg-paper px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-ink"
            >New book · 2026</span
          >
          <h2 class="mt-3 font-display text-2xl font-medium leading-snug text-paper">
            {featuredBook.title}
          </h2>
          <p class="mt-2 text-sm text-paper/60">{featuredBook.authors}</p>
          <p class="mt-4 text-sm leading-relaxed text-paper/70">
            {featuredBook.abstract}
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a
              href={featuredBook.amazon}
              target="_blank"
              rel="noopener"
              class="rounded-full bg-paper px-5 py-2 text-sm font-semibold text-ink transition-transform hover:-translate-y-0.5"
              >View on Amazon ↗</a
            >
            <a
              href="https://global.oup.com/academic/product/9780197813348"
              target="_blank"
              rel="noopener"
              class="rounded-full border border-paper/25 px-5 py-2 text-sm font-semibold text-paper transition-colors hover:border-paper/60"
              >Oxford University Press ↗</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Themes -->
  {
    themes.map((theme, ti) => (
      <section
        id={theme.id}
        class:list={[
          "scroll-mt-24 px-6 py-20 md:px-10",
          ti % 2 === 0 ? "bg-paper text-ink" : "bg-ink text-paper",
        ]}
      >
        <div class="mx-auto max-w-5xl">
          <div class="flex items-baseline gap-4" data-reveal>
            <span
              class:list={[
                "font-mono text-sm",
                ti % 2 === 0 ? "text-terra" : "text-terra-bright",
              ]}
            >
              {String(ti + 1).padStart(2, "0")}
            </span>
            <h2 class="font-display text-3xl font-light tracking-tight sm:text-4xl">
              {theme.title}
            </h2>
          </div>
          <p
            class:list={[
              "mt-4 max-w-2xl text-base leading-relaxed",
              ti % 2 === 0 ? "text-ink/60" : "text-paper/60",
            ]}
            data-reveal
          >
            {theme.blurb}
          </p>

          <ol class="mt-10 space-y-5">
            {theme.publications.map((pub) => (
              <li data-reveal>
                <details
                  class:list={[
                    "group rounded-xl border p-6 transition-colors",
                    ti % 2 === 0
                      ? "border-ink/10 bg-white/40 hover:border-ink/25"
                      : "border-white/10 bg-white/5 hover:border-white/25",
                  ]}
                >
                  <summary class="flex cursor-pointer list-none items-start gap-4">
                    <div class="flex-1">
                      <div class="flex flex-wrap items-center gap-3">
                        <span
                          class:list={[
                            "rounded-full px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider",
                            pub.type === "book"
                              ? "bg-paper text-ink"
                              : ti % 2 === 0
                                ? "bg-ink/10 text-ink/70"
                                : "bg-white/10 text-paper/70",
                          ]}
                        >
                          {typeLabel[pub.type]}
                        </span>
                        <span
                          class:list={[
                            "font-mono text-xs",
                            ti % 2 === 0 ? "text-ink/50" : "text-paper/50",
                          ]}
                        >
                          {pub.year}
                        </span>
                      </div>
                      <h3 class="mt-2 font-display text-xl font-medium leading-snug">
                        {pub.title}
                      </h3>
                      <p
                        class:list={[
                          "mt-1 text-sm",
                          ti % 2 === 0 ? "text-ink/60" : "text-paper/60",
                        ]}
                      >
                        {pub.authors}
                      </p>
                      <p
                        class:list={[
                          "mt-1 text-sm italic",
                          ti % 2 === 0 ? "text-ink/50" : "text-paper/50",
                        ]}
                      >
                        {pub.venue}
                      </p>
                    </div>
                    <span
                      class="mt-1 shrink-0 text-terra transition-transform group-open:rotate-45"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </summary>

                  <div
                    class:list={[
                      "mt-4 border-t pt-4 text-sm leading-relaxed",
                      ti % 2 === 0
                        ? "border-ink/10 text-ink/75"
                        : "border-white/10 text-paper/75",
                    ]}
                  >
                    <p>
                      {pub.summary && (
                        <span
                          class:list={[
                            "mr-1 font-mono text-[10px] uppercase tracking-wider",
                            ti % 2 === 0 ? "text-ink/40" : "text-paper/40",
                          ]}
                        >
                          [summary]
                        </span>
                      )}
                      {pub.abstract}
                    </p>
                    <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
                      {pub.doi && (
                        <a
                          href={doiUrl(pub.doi)}
                          target="_blank"
                          rel="noopener"
                          class="link-underline inline-block font-mono text-xs text-terra"
                        >
                          doi.org/{pub.doi} →
                        </a>
                      )}
                      {pub.amazon && (
                        <a
                          href={pub.amazon}
                          target="_blank"
                          rel="noopener"
                          class="link-underline inline-block font-mono text-xs text-terra"
                        >
                          View on Amazon →
                        </a>
                      )}
                    </div>
                  </div>
                </details>
              </li>
            ))}
          </ol>
        </div>
      </section>
    ))
  }

  <!-- Full CV CTA -->
  <section class="bg-ink px-6 py-20 md:px-10">
    <div
      class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-6 rounded-2xl border border-white/10 bg-white/[0.03] p-8 sm:flex-row sm:items-center sm:p-10"
      data-reveal
    >
      <div>
        <h2 class="font-display text-2xl font-medium text-paper">
          Looking for the complete record?
        </h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-paper/60">
          The full curriculum vitae lists every publication, grant, course, and
          appointment — available to read online or download as a PDF.
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <a
          href="/cv"
          class="rounded-full bg-paper px-6 py-2.5 text-sm font-semibold text-ink transition-transform hover:-translate-y-0.5"
          >View CV</a
        >
        <a
          href="/cv#download"
          class="rounded-full border border-paper/25 px-6 py-2.5 text-sm font-semibold text-paper transition-colors hover:border-paper/60"
          >Download PDF</a
        >
      </div>
    </div>
  </section>
</Base>
