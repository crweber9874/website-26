---
import CommonLayout from "@/layouts/CommonLayout.astro"
import Button from "@/components/base/Button.astro"
import Card from "@/components/base/card/Card.astro"
import CardContent from "@/components/base/card/CardContent.astro"
import CardGroup from "@/components/base/card/CardGroup.astro"
import CardHeader from "@/components/base/card/CardHeader.astro"
import CardTitle from "@/components/base/card/CardTitle.astro"
import Section from "@/components/layout/Section.astro"
import { courses } from "@/data/teaching"

const description =
  "Graduate methods course readers for the University of Arizona, written to accompany the texts each course is built around."

// The site is configured with trailingSlash: "never", so course reader paths
// (authored with a trailing slash in teaching.ts) are normalized here.
const readerHref = (url: string) => url.replace(/\/$/, "")
---

<CommonLayout
  title="Pedagogy"
  description={description}
  breadcrumbs={[{ label: "Pedagogy" }]}
  prose={false}
>
  {
    courses.map((course) => (
      <Section title={`${course.code} · ${course.title}`}>
        <p class="course-subtitle">{course.subtitle}</p>
        <p class="course-description">{course.description}</p>

        <ul class="course-topics">
          {course.topics.map((topic) => (
            <li>{topic}</li>
          ))}
        </ul>

        {course.url && (
          <div class="course-actions">
            <Button href={readerHref(course.url)} variant="default">
              Open the course reader
            </Button>
            {course.repo && (
              <Button href={course.repo} variant="ghost">
                Source
              </Button>
            )}
          </div>
        )}

        {course.coreTexts && course.coreTexts.length > 0 && (
          <CardGroup columns={2} class="course-texts">
            {course.coreTexts.map((text) => (
              <Card as="section" padding="compact">
                <CardHeader>
                  <CardTitle>{text.title}</CardTitle>
                </CardHeader>
                <CardContent>
                  <p class="course-text-meta">
                    {text.authors} · {text.year} · {text.publisher}
                  </p>
                </CardContent>
              </Card>
            ))}
          </CardGroup>
        )}
      </Section>
    ))
  }
</CommonLayout>

<style>
  .course-subtitle {
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .course-description {
    margin: 0;
    max-inline-size: 68ch;
  }

  .course-topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .course-topics li {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .course-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .course-texts {
    margin-block-start: var(--space-2xs);
  }

  .course-text-meta {
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }
</style>
