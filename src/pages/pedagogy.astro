---
import Base from "@/layouts/Base.astro";
import { courses } from "@/data/teaching";
---

<Base title="Pedagogy">
  <!-- Header -->
  <section class="bg-ink px-6 pb-16 pt-40 md:px-10">
    <div class="mx-auto max-w-5xl">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-terra" data-reveal>
        Pedagogy
      </p>
      <h1
        class="mt-4 font-display text-4xl font-light leading-tight tracking-tight text-paper sm:text-6xl"
        data-reveal
      >
        Teaching Resources
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-paper/70" data-reveal>
        Course readers for my graduate methods sequence, hosted on this site.
        Each reader is meant to <em>accompany</em> the standard textbooks listed
        under each course — I draw on many of their concepts and formulas, and
        the reader is not a substitute for those sources. Open a reader
        full-screen, or browse the preview below.
      </p>
    </div>
  </section>

  <!-- Courses -->
  {
    courses.map((course, i) => (
      <section
        class:list={[
          "px-6 py-20 md:px-10",
          i % 2 === 0 ? "bg-paper text-ink" : "bg-ink text-paper",
        ]}
      >
        <div class="mx-auto max-w-6xl">
          <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
            <div>
              <div class="flex items-center gap-3">
                <span class="font-mono text-sm text-terra">{course.code}</span>
                {course.status && (
                  <span class="rounded-full border border-current/20 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider opacity-60">
                    {course.status}
                  </span>
                )}
              </div>
              <h2 class="mt-2 font-display text-3xl font-light tracking-tight sm:text-4xl">
                {course.url ? (
                  <a href={course.url} class="hover:underline">
                    {course.title}
                  </a>
                ) : (
                  course.title
                )}
              </h2>
              <p
                class:list={[
                  "mt-1 text-sm",
                  i % 2 === 0 ? "text-ink/50" : "text-paper/50",
                ]}
              >
                {course.subtitle}
              </p>
            </div>
            {course.url && (
              <a
                href={course.url}
                class:list={[
                  "rounded-full px-6 py-2.5 text-sm font-semibold transition-transform hover:-translate-y-0.5",
                  i % 2 === 0 ? "bg-ink text-paper" : "bg-paper text-ink",
                ]}
              >
                Open book
              </a>
            )}
            {!course.url && course.repo && (
              <a
                href={course.repo}
                target="_blank"
                rel="noopener"
                class:list={[
                  "rounded-full border px-6 py-2.5 text-sm font-semibold transition-colors",
                  i % 2 === 0
                    ? "border-ink/25 hover:border-ink"
                    : "border-paper/25 hover:border-paper",
                ]}
              >
                View on GitHub ↗
              </a>
            )}
          </div>

          <p
            class:list={[
              "mt-6 max-w-3xl text-base leading-relaxed",
              i % 2 === 0 ? "text-ink/70" : "text-paper/70",
            ]}
            data-reveal
          >
            {course.description}
          </p>

          <div class="mt-5 flex flex-wrap gap-2" data-reveal>
            {course.topics.map((t) => (
              <span
                class:list={[
                  "rounded-full px-3 py-1 text-xs font-medium",
                  i % 2 === 0 ? "bg-ink/8 text-ink/70" : "bg-white/10 text-paper/70",
                ]}
              >
                {t}
              </span>
            ))}
          </div>

          {course.coreTexts && course.coreTexts.length > 0 && (
            <div class="mt-8" data-reveal>
              <p
                class:list={[
                  "font-mono text-[11px] uppercase tracking-[0.2em]",
                  i % 2 === 0 ? "text-ink/45" : "text-paper/45",
                ]}
              >
                Course textbooks (required companions)
              </p>
              <p
                class:list={[
                  "mt-2 max-w-3xl text-sm leading-relaxed",
                  i % 2 === 0 ? "text-ink/55" : "text-paper/55",
                ]}
              >
                This reader accompanies these textbooks. I draw on many of their
                concepts and formulas; work through the assigned chapters in
                parallel with the reader.
              </p>
              <ul
                class:list={[
                  "mt-3 space-y-2 border-l-2 pl-4 text-sm leading-relaxed",
                  i % 2 === 0 ? "border-ink/15" : "border-paper/15",
                ]}
              >
                {course.coreTexts.map((t) => (
                  <li>
                    <span class="font-medium">{t.authors}</span>{" "}
                    <span class={i % 2 === 0 ? "text-ink/55" : "text-paper/55"}>
                      ({t.year}).
                    </span>{" "}
                    <span class="italic">{t.title}.</span>{" "}
                    <span class={i % 2 === 0 ? "text-ink/55" : "text-paper/55"}>
                      {t.publisher}.
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {course.embed && course.url ? (
            <div
              class="mt-10 overflow-hidden rounded-2xl border border-current/15 shadow-2xl shadow-black/30"
              data-reveal
            >
              <div
                class:list={[
                  "flex flex-wrap items-center justify-between gap-3 border-b border-current/10 px-4 py-2.5",
                  i % 2 === 0 ? "bg-ink text-paper" : "bg-ink-800",
                ]}
              >
                <div class="flex min-w-0 items-center gap-2">
                  <span class="h-3 w-3 rounded-full bg-paper/70" />
                  <span class="h-3 w-3 rounded-full bg-paper/40" />
                  <span class="h-3 w-3 rounded-full bg-paper/25" />
                  <span class="ml-3 truncate font-mono text-xs text-paper/50">
                    {course.url}
                  </span>
                </div>
                <a
                  href={course.url}
                  class="shrink-0 rounded-full bg-paper px-3 py-1 text-xs font-semibold text-ink"
                >
                  Open book ↗
                </a>
              </div>
              <iframe
                src={course.url}
                title={`${course.code}: ${course.title}`}
                loading="eager"
                class="h-[70vh] w-full bg-white"
              />
              <p
                class:list={[
                  "border-t border-current/10 px-4 py-2 text-xs",
                  i % 2 === 0 ? "bg-paper text-ink/50" : "bg-ink text-paper/50",
                ]}
              >
                Preview only — use <a href={course.url} class="underline">Open book</a> for
                navigation, search, and chapters (some chapters are large and load slowly).
              </p>
            </div>
          ) : (
            <div
              class:list={[
                "mt-10 flex flex-col items-center justify-center rounded-2xl border border-dashed p-16 text-center",
                i % 2 === 0 ? "border-ink/20" : "border-paper/20",
              ]}
              data-reveal
            >
              <p class="font-display text-2xl">Coming soon</p>
              <p
                class:list={[
                  "mt-2 max-w-md text-sm",
                  i % 2 === 0 ? "text-ink/60" : "text-paper/60",
                ]}
              >
                This book is still in development. The source and pipeline are
                available on GitHub; the rendered book will be embedded here once
                published.
              </p>
            </div>
          )}
        </div>
      </section>
    ))
  }
</Base>
