---
import CommonLayout from "@/layouts/CommonLayout.astro"
import Button from "@/components/base/Button.astro"
import Card from "@/components/base/card/Card.astro"
import CardContent from "@/components/base/card/CardContent.astro"
import CardGroup from "@/components/base/card/CardGroup.astro"
import CardHeader from "@/components/base/card/CardHeader.astro"
import CardTitle from "@/components/base/card/CardTitle.astro"
import Section from "@/components/layout/Section.astro"
import SandboxChart from "@/components/react/SandboxChart.tsx"
import { sandboxCharts } from "@/data/voter"

const modules = [
  {
    title: "My Story",
    href: "/voter/story",
    tag: "Guided tour",
    blurb:
      "Who is registered, where they live, and whether they voted — never who they voted for. Scroll from counties to congressional districts.",
  },
  {
    title: "The Explorer",
    href: "/voter/explorer",
    tag: "Choropleth · time series",
    blurb:
      "Explore characteristics of the Arizona voter file, aggregated to counties, districts, precincts, ZCTAs, tracts, and block groups.",
  },
  {
    title: "Party Transitions",
    href: "/voter/party",
    tag: "Sankey · Markov model",
    blurb:
      "Movement between party registrations from a continuous-time Markov model, so irregular file windows share one rate clock, with steady-state projections.",
  },
  {
    title: "Common Ground",
    href: "/voter/agreement",
    tag: "Overlap",
    blurb:
      "How much do Arizonans actually overlap? An overlapping-coefficient (OVL) tool measuring shared opinion across party, race, religion, and demographics.",
  },
  {
    title: "Voting",
    href: "/voter/voting",
    tag: "Precinct analytics",
    blurb:
      "Precinct-level turnout and vote distributions, with county comparisons.",
  },
  {
    title: "Opinion",
    href: "/voter/opinion",
    tag: "Survey",
    blurb: "Opinion measures alongside the registration and turnout record.",
  },
  {
    title: "Understanding the file",
    href: "/voter/understanding",
    tag: "Reference",
    blurb:
      "Field definitions, de-identification, small-cell suppression, party buckets, and build-over-build comparisons.",
  },
]

const description =
  "Maps and models of Arizona's electorate — registration, turnout, party movement, and shared opinion."
---

<CommonLayout
  title="The Arizona Voter Project"
  description={description}
  breadcrumbs={[{ label: "Voter Project" }]}
  prose={false}
>
  <p class="voter-beta">
    <strong>Beta.</strong> Every module below is a beta release. Figures and underlying
    data are preliminary, under active development, and will migrate to the official
    <a href="https://voterproject.arizona.edu" rel="noopener" target="_blank"
      >project website</a
    >.
  </p>

  <div class="voter-actions">
    <Button href="/voter/story" variant="primary">Take the story tour</Button>
    <Button href="/voter/explorer" variant="default">Open the Explorer</Button>
  </div>

  <Section title="Modules">
    <CardGroup columns={2}>
      {
        modules.map((mod) => (
          <Card as="article" href={mod.href} padding="compact">
            <CardHeader>
              <CardTitle>{mod.title}</CardTitle>
              <p class="voter-tag">{mod.tag}</p>
            </CardHeader>
            <CardContent>
              <p class="voter-blurb">{mod.blurb}</p>
            </CardContent>
          </Card>
        ))
      }
    </CardGroup>
  </Section>

  <Section title="Charts">
    <div class="voter-charts">
      {
        sandboxCharts.map((chart) => (
          <SandboxChart client:only="react" title={chart.title} src={chart.src} />
        ))
      }
    </div>
  </Section>
</CommonLayout>

<style>
  .voter-beta {
    padding: var(--space-2xs);
    border-inline-start: 3px solid var(--primary);
    background: var(--muted);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    max-inline-size: 72ch;
  }

  .voter-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-s);
  }

  .voter-tag {
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .voter-blurb {
    margin: 0;
  }

  .voter-charts {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  :global(.sandbox-chart) {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--background);
  }

  :global(.sandbox-chart-bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding: var(--space-3xs) var(--space-2xs);
    border-block-end: 1px solid var(--border);
  }

  :global(.sandbox-chart-title) {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  :global(.sandbox-chart-download) {
    flex-shrink: 0;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background var(--motion-duration) var(--motion-ease);
  }

  :global(.sandbox-chart-download:hover) {
    background: var(--muted);
  }

  :global(.sandbox-chart-download:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  :global(.sandbox-chart-frame) {
    display: block;
    inline-size: 100%;
    block-size: 360px;
    border: 0;
  }

  :global(.sandbox-chart-error) {
    margin: 0;
    padding: var(--space-3xs) var(--space-2xs);
    border-block-start: 1px solid var(--border);
    color: var(--destructive);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }
</style>
