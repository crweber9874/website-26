---
import Layout from "../layouts/Layout.astro";
import SandboxChart from "../components/react/SandboxChart.tsx";
import { sandboxCharts } from "../data/voter";

const modules = [
  {
    title: "My Story",
    href: "/voter/story",
    code: "Guided tour",
    summary:
      "Who is registered, where they live, and whether they voted — never who they voted for. Scroll from counties to congressional districts.",
  },
  {
    title: "The Explorer",
    href: "/voter/explorer",
    code: "Choropleth · time series",
    summary:
      "Explore characteristics of the Arizona voter file, aggregated to counties, districts, precincts, ZCTAs, tracts, and block groups.",
  },
  {
    title: "Party Transitions",
    href: "/voter/party",
    code: "Sankey · Markov model",
    summary:
      "Movement between party registrations from a continuous-time Markov model, so irregular file windows share one rate clock, with steady-state projections.",
  },
  {
    title: "Common Ground",
    href: "/voter/agreement",
    code: "Overlap",
    summary:
      "How much do Arizonans actually overlap? An overlapping-coefficient (OVL) tool measuring shared opinion across party, race, religion, and demographics.",
  },
  {
    title: "Voting",
    href: "/voter/voting",
    code: "Precinct analytics",
    summary:
      "Precinct-level turnout and vote distributions, with county comparisons.",
  },
  {
    title: "Opinion",
    href: "/voter/opinion",
    code: "Survey",
    summary:
      "Opinion measures alongside the registration and turnout record.",
  },
  {
    title: "Understanding the file",
    href: "/voter/understanding",
    code: "Reference",
    summary:
      "Field definitions, de-identification, small-cell suppression, party buckets, and build-over-build comparisons.",
  },
];

const pageTitle = "The Arizona Voter Project";
const pageDescription =
  "Maps and models of Arizona's electorate — registration, turnout, party movement, and shared opinion.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schemaType="CollectionPage"
>
  <div class="page-stack">
    <header class="page-header">
      <p class="page-kicker">Public-facing data science</p>
      <h1 class="page-title">{pageTitle}</h1>
      <p class="page-description">{pageDescription}</p>

      <p
        class="mt-3 border-l-2 border-accent-500 pl-4 text-sm text-gray-600 dark:text-gray-300"
      >
        <strong>Beta.</strong> Every module below is a beta release. Figures and
        underlying data are preliminary, under active development, and will
        migrate to the official
        <a
          href="https://voterproject.arizona.edu"
          target="_blank"
          rel="noreferrer"
          class="underline">project website</a
        >.
      </p>

      <div class="flex flex-wrap gap-2 pt-2">
        <a href="/voter/story" class="action-link glass-control px-3.5 min-h-11">
          <span class="i-mdi:map-marker-path" aria-hidden="true"></span>
          Take the story tour
        </a>
        <a
          href="/voter/explorer"
          class="action-link glass-control px-3.5 min-h-11"
        >
          <span class="i-mdi:chart-box-outline" aria-hidden="true"></span>
          Open the Explorer
        </a>
      </div>
    </header>

    <section class="content-section space-y-5">
      <header
        class="flex items-end justify-between gap-4 border-b border-gray-200 pb-3 dark:border-gray-700"
      >
        <div class="space-y-1">
          <p class="section-kicker">Data modules</p>
          <h2 class="section-heading">Seven ways into the file</h2>
        </div>
        <p
          class="shrink-0 text-xs font-semibold uppercase tracking-[0.14em] text-accent-700 dark:text-accent-300"
        >
          {modules.length} modules
        </p>
      </header>

      <div class="grid gap-4 md:grid-cols-2">
        {
          modules.map((module) => (
            <article class="surface-card-hover border-t-2 border-t-accent-500">
              <div class="space-y-3">
                <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-accent-700 dark:text-accent-300">
                  {module.code}
                </p>
                <h3 class="entry-title">
                  <a href={module.href} class="no-underline hover:underline">
                    {module.title}
                  </a>
                </h3>
                <p class="entry-summary">{module.summary}</p>
                <a href={module.href} class="action-link min-h-11">
                  <span class="i-mdi:arrow-right" aria-hidden="true" />
                  Launch module
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="content-section space-y-5">
      <header
        class="flex items-end justify-between gap-4 border-b border-gray-200 pb-3 dark:border-gray-700"
      >
        <div class="space-y-1">
          <p class="section-kicker">Sandbox</p>
          <h2 class="section-heading">Charts</h2>
        </div>
      </header>

      <div class="space-y-6">
        {
          sandboxCharts.map((chart) => (
            <SandboxChart client:only="react" title={chart.title} src={chart.src} />
          ))
        }
      </div>
    </section>
  </div>
</Layout>

<style is:global>
  .sandbox-chart {
    overflow: hidden;
    border: 1px solid rgb(229 231 235);
    border-radius: 0.75rem;
    background: #fff;
  }
  .dark .sandbox-chart {
    border-color: rgb(55 65 81);
    background: rgb(17 24 39);
  }
  .sandbox-chart-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid rgb(229 231 235);
  }
  .dark .sandbox-chart-bar {
    border-color: rgb(55 65 81);
  }
  .sandbox-chart-title {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: rgb(75 85 99);
  }
  .dark .sandbox-chart-title {
    color: rgb(209 213 219);
  }
  .sandbox-chart-download {
    flex-shrink: 0;
    padding: 0.25rem 0.75rem;
    border: 1px solid rgb(209 213 219);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font-family: ui-monospace, monospace;
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
  }
  .sandbox-chart-download:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .sandbox-chart-frame {
    display: block;
    width: 100%;
    height: 360px;
    border: 0;
    background: #fff;
  }
  .sandbox-chart-error {
    margin: 0;
    padding: 0.5rem 1rem;
    border-top: 1px solid rgb(229 231 235);
    color: rgb(185 28 28);
    font-family: ui-monospace, monospace;
    font-size: 0.6875rem;
  }
</style>
