@book{federico2026authoritarian,
  title={The Authoritarian Divide: Partisan Identity, Voting, and the Transformation of the American Electorate},
  author={Christopher M. Federico and Stanley Feldman and Christopher Weber},
  publisher={Oxford University Press},
  series={Series in Political Psychology},
  year={2026},
  selected={true},
  keywords={Political Psychology,Authoritarianism,Partisanship},
  url={https://www.amazon.com/dp/0197813348},
  abstract={The Authoritarian Divide shows how authoritarian predispositions --- desires for social and in-group conformity --- have increasingly structured American political preferences, voting, and partisanship over recent decades. Drawing on nationally representative samples, panel data, and experiments, the authors trace how voters have sorted into parties by their levels of authoritarianism (higher toward the Republican Party, lower toward the Democratic), revealing complexities including the outsized effect on White Americans, dependence on the choices parties offer, and the role of education. The analysis carries crucial implications for partisan conflict and the future of American democracy. (Editorial summary --- not the published abstract.)}
}

@incollection{feldman2024authoritarianism,
  title={Authoritarianism and Political Conflict},
  author={Stanley Feldman and Christopher Weber},
  booktitle={The Oxford Handbook of Political Psychology},
  publisher={Oxford University Press},
  year={2024},
  doi={10.1093/oxfordhb/9780197541302.013.19},
  selected={true},
  keywords={Political Psychology,Authoritarianism},
  abstract={We review recent research on authoritarianism with the goal of addressing major issues of conceptualization, measurement, and political consequences. We highlight a conceptualization of authoritarianism that identifies the desire for social cohesion and defense of ingroup norms as central to its dynamics. The consequences of authoritarianism---intolerance of dissent, out-group animosity, and support for anti-democratic leaders and parties---result from the experience of threat to social cohesion among those with authoritarian predispositions. Threats may be associated with processes of social change (changing gender norms) or changes to the status of the majority group from immigration. The role of threat helps provide a basis for understanding the conditions under which authoritarianism becomes a politically potent force.}
}

@incollection{schuler2023ideology,
  title={Ideology in Vietnam: Evidence from Asian Barometer Data},
  author={Paul Schuler and Mai Truong and Christopher Weber},
  booktitle={20th Anniversary of the ABS, Commemorative Volume},
  year={2023},
  keywords={Political Psychology,Comparative},
  abstract={Using Asian Barometer Survey data, this chapter examines the structure and correlates of ideology in Vietnam, extending questions about authoritarian dispositions and redistribution to a single-party, left-authoritarian context. (Editorial summary --- not the published abstract.)}
}

@article{weber2019divided,
  title={Why Are We Divided? Understanding the Social and Ideological Foundations of Partisan Sorting and Polarization},
  author={Christopher Weber and Samara Klar},
  journal={Advances in Political Psychology},
  volume={40},
  pages={215--244},
  year={2019},
  doi={10.1111/pops.12574},
  selected={true},
  keywords={Political Psychology,Polarization,Partisanship},
  abstract={Americans are sorting ideologically: liberals and conservatives are more likely to respectively identify as Democrats and Republicans. They are sorting socially as well: partisans like and trust copartisans more than opposing partisans. Existing explanations rely on exogenous factors such as elite polarization, but these cannot fully explain variation in sorting. We argue that psychological characteristics help explain the tendency to sort ideologically or socially---specifically, an individual's responsiveness to internal values versus normative social pressures. Testing this with several nationally representative surveys and a survey experiment, we find strong support that a person's own tendency to respond to social cues, as opposed to ideological values, has important consequences for this process.}
}

@article{davis2019affective,
  title={Affective Consistency and Sorting},
  author={Nicholas T. Davis and Samara Klar and Christopher Weber},
  journal={Social Science Quarterly},
  volume={100},
  number={6},
  pages={2477--2494},
  year={2019},
  doi={10.1111/ssqu.12695},
  selected={true},
  keywords={Political Psychology,Polarization,Emotion},
  abstract={Sorting is often portrayed as a mechanistic response to elite polarization: individuals recognize salient differences between the parties and match their preferences accordingly. Much less is known about the psychological and motivational processes that contribute to it. Analyzing cross-sectional and panel data from the American National Election Studies, we find that negative emotions directed toward the opposing party candidate and positive emotions toward one's own party candidate are associated with an increase in the alignment of ideological and partisan preferences---illustrating how affect contributes to consistency in mass opinion.}
}

