}

@article{kenny2017characteristics,
  title={The Characteristics of Interpersonal Networks in Disaster Response},
  author={Christopher Kenny and Christopher Weber and Kathleen Bratton},
  journal={Social Science Quarterly},
  volume={98},
  number={2},
  pages={566--583},
  year={2017},
  doi={10.1111/ssqu.12328},
  keywords={Methods,Networks},
  abstract={Discussion networks have meaningful consequences for sociopolitical attitudes and behavior. We explore how social structure shapes reactions to disaster---specifically, the 2010 BP oil spill---by experimentally varying the commonly used discussion `name-generator' questions. Relative to `important matters' discussants, we find strong support for a specialist model: oil spill discussants tend to be less intimate, more knowledgeable, more active, and more talkative about the spill, suggesting a contextual basis for the formation of and reliance on discussion networks.}
}

@article{klar2016social,
  title={Social Desirability Bias in the 2016 Presidential Election},
  author={Samara Klar and Christopher Weber and Yanna Krupnikov},
  journal={The Forum},
  volume={14},
  number={4},
  pages={433--443},
  year={2016},
  doi={10.1515/for-2016-0037},
  selected={true},
  keywords={Methods,Measurement,Public Opinion},
  abstract={Partisanship is a stable trait, but expressions of partisan preferences can vary according to social context. Relying on the psychological trait of self-monitoring, we show that Americans more likely to adjust their behavior to comply with social norms (high self-monitors) were less likely to express support for Donald Trump during the 2016 election; as self-monitoring decreases, the tendency to express Trump support increases. This suggests that---at least for some individuals---there may have been a tendency to repress expressed support for Trump to mask socially undesirable attitudes.}
}

@article{lebo2015effective,
  title={An Effective Approach to the Repeated Cross-Sectional Design},
  author={Matthew Lebo and Christopher Weber},
  journal={American Journal of Political Science},
  volume={59},
  number={1},
  pages={242--258},
  year={2015},
  doi={10.1111/ajps.12095},
  selected={true},
  keywords={Methods,Time Series,Measurement},
  abstract={Repeated cross-sectional (RCS) designs are distinguishable from true panels and pooled cross-sectional time series because cross-sectional units appear only once. This poses two challenges: autocorrelation threatens inferences, yet common solutions like lagged dependent variables are impossible; and available methods force a choice between aggregate- and individual-level analysis. We offer a solution---double filtering with ARFIMA methods to account for autocorrelation, followed by multilevel modeling to estimate aggregate- and individual-level parameters simultaneously---demonstrated with Monte Carlo experiments and three applied examples.}
}

@article{cassese2013socially,
  title={Socially-Mediated Internet Surveys (SMIS): Recruiting Participants for Online Experiments},
  author={Erin Cassese and Leonie Huddy and Todd Hartman and Lilliana Mason and Christopher Weber},
  journal={PS: Political Science \& Politics},
  volume={46},
  number={4},
  pages={775--784},
  year={2013},
  doi={10.1017/s1049096513001029},
  keywords={Methods,Survey Design},
  abstract={The Socially Mediated Internet Survey (SMIS) method is a cost-effective technique for obtaining web-based adult samples for experimental research, engaging central figures in online social networks to help recruit participants. We present data from six SMIS samples and compare them to approaches such as Amazon's Mechanical Turk. While not representative of the general adult population, SMIS samples are significantly more diverse than undergraduate convenience samples---demographically and politically---and can capture highly engaged citizens, helping to address concerns about the artificiality of student-based experiments.}
}
