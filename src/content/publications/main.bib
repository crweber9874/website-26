@article{weber2014placing,
  title={Placing Racial Stereotypes in Context: Social Desirability and the Politics of Racial Hostility},
  author={Christopher Weber and Howard Lavine and Leonie Huddy and Christopher M. Federico},
  journal={American Journal of Political Science},
  volume={58},
  number={1},
  pages={63--78},
  year={2014},
  doi={10.1111/ajps.12051},
  selected={true},
  keywords={Political Psychology,Race,Public Opinion},
  abstract={Past research indicates that diversity at the level of larger geographic units is linked to white racial hostility, but research has not addressed whether diverse local contexts strengthen or weaken the relationship between racial stereotypes and policy attitudes. In a statewide opinion survey, we find that black-white diversity at the zip-code level strengthens the connection between racial stereotypes and race-related policy attitudes among whites---an effect most pronounced among low self-monitors, who are relatively immune to egalitarian social norms. The racializing effect is most evident for stereotypes relevant to a given policy.}
}

@article{federico2013mapping,
  title={Mapping the Connections between Politics and Morality: The Multiple Sociopolitical Orientations Involved in Moral Intuition},
  author={Christopher M. Federico and Christopher Weber and Damla Ergun and Corrie Hunt},
  journal={Political Psychology},
  volume={34},
  number={4},
  pages={589--610},
  year={2013},
  doi={10.1111/pops.12006},
  selected={true},
  keywords={Political Psychology,Morality,Ideology},
  abstract={According to moral foundations theory, five foundations are central to moral intuition: the individualizing foundations (harm/care and fairness/reciprocity) hinge on the rights of the individual, whereas the binding foundations (in-group/loyalty, authority/respect, and purity/sanctity) focus on communal bonds. We argue that only certain sociopolitical attitudes relate to each cluster. Drawing on dual-process models, we show the individualizing foundations align with preferences for equality versus inequality (SDO and competitive-jungle beliefs), whereas the binding foundations align with preferences for openness versus social conformity (RWA and dangerous-world beliefs).}
}

@article{weber2013moral,
  title={Moral Foundations and Heterogeneity in Ideological Preferences},
  author={Christopher Weber and Christopher M. Federico},
  journal={Political Psychology},
  volume={34},
  number={1},
  pages={107--126},
  year={2013},
  doi={10.1111/j.1467-9221.2012.00922.x},
  selected={true},
  keywords={Political Psychology,Morality,Ideology},
  abstract={Moral foundations theory contends that divisions between liberals and conservatives are rooted in different views of morality, with liberals disproportionately valuing the individualizing foundations while conservatives value all five more equally. We extend this by examining whether different types of liberals and conservatives value the foundations to varying degrees. Using survey data (n = 745) and a mixed-mode latent class analysis, we identify six ideological classes that favor unique social and fiscal policy positions and endorse the moral foundations in varying degrees---demonstrating considerable heterogeneity in ideology and moral preferences.}
}

@article{weber2013emotions,
  title={Emotions, Campaigns, and Political Participation},
  author={Christopher Weber},
  journal={Political Research Quarterly},
  volume={66},
  number={2},
  pages={414--428},
  year={2013},
  doi={10.1177/1065912912449697},
  selected={true},
  keywords={Political Psychology,Emotion,Participation},
  abstract={There has been a scarcity of work examining the political consequences of discrete emotions. This article examines the political effects of anger, sadness, fear, and enthusiasm. Two experiments are administered: the first examines emotional responses to campaign messages; the second tests whether emotions influence political participation. The results indicate anger is mobilizing, increasing participatory intentions and related factors---a result then replicated using ad-tracking data. Emotions are an important factor in studying campaign effects.}
}

@article{weber2011genetics,
  title={Genetics, Personality, and Group Identity},
  author={Christopher Weber and Martin Johnson and Kevin Arceneaux},
  journal={Social Science Quarterly},
  volume={92},
  number={5},
  pages={1314--1337},
  year={2011},
  doi={10.1111/j.1540-6237.2011.00820.x},
  keywords={Political Psychology,Identity},
  abstract={We investigate why people identify with groups and show favoritism to in-group members, anticipating that group identifications are substantially influenced by genes and social environments, likely working through stable personality traits. Using twin-study data from the National Survey of Midlife Development (MIDUS I), we examine the heritability of in-group identification and favoritism and the extent to which their genetic bases are shared with the Big Five personality traits. Group identification is largely attributable to genetic factors, though environments also matter; personality heritability accounts for a modest portion of the genetic variation.}
}

