@article{weber2007interpersonal,
  title={Interpersonal Attachment and Patterns of Ideological Belief},
  author={Christopher Weber and Christopher M. Federico},
  journal={Political Psychology},
  volume={28},
  number={4},
  pages={389--416},
  year={2007},
  doi={10.1111/j.1467-9221.2007.00579.x},
  keywords={Political Psychology,Authoritarianism,Ideology},
  abstract={We examine whether two general dimensions of sociopolitical belief---right-wing authoritarianism (RWA) and social dominance orientation (SDO)---are rooted in insecure psychological attachment. A structural equation model indicated that anxious attachment led to RWA but not SDO, mediated by the belief that the world is a dangerous place; avoidant attachment led to SDO but not RWA, mediated by the belief that the world is an uncaring, competitive jungle. We discuss the implications for the nature and origins of political conservatism.}
}

@article{huddy2007political,
  title={The Political Consequences of Perceived Threat and Felt Insecurity},
  author={Leonie Huddy and Stanley Feldman and Christopher Weber},
  journal={The ANNALS of the American Academy of Political and Social Science},
  year={2007},
  doi={10.1177/0002716207305951},
  keywords={Political Psychology,Threat,Public Opinion},
  abstract={Drawing on a national telephone sample of 1,549 adult Americans conducted between October 2001 and March 2002, we explore the impact of a need for security on support for national security policies after the 9/11 attacks. We examine support for protective government policies among individuals who vary in their ability to feel secure, exploring the interaction between perceived threat and felt security. Most Americans reported a sense of security after 9/11, but a sense of insecurity among a minority coupled with a perceived threat of future terrorism increased support for both domestic and international security policy---the curtailment of civil liberties, tougher visa checks, and support for the war in Afghanistan. Our findings underscore the diverse ways individuals react politically to a common external threat.}
}

