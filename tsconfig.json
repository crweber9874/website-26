{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@icon-config": ["./src/icon.config.ts"],
      "@site-config": ["./src/site.config.ts"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "*.ts", "*.mjs"],
  "exclude": ["dist", "public", "node_modules", "teaching"]
}
